# Copiar a .env y ajustar. Prefijo FINANZAS_ (ver app/config.py)
FINANZAS_DATABASE_URL=postgresql+psycopg://finanzas:finanzas@localhost:5433/finanzas

# Seguridad (¡cámbialo en producción!)
FINANZAS_SECRET_KEY=cambiar-por-un-secreto-largo-y-aleatorio
FINANZAS_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Zona horaria para "hoy" (ingresos recurrentes, alertas) y scheduler
FINANZAS_TIMEZONE=America/Bogota
FINANZAS_SCHEDULER_ENABLED=true

# OCR por línea (opcional): embeddings para clasificar los artículos de una
# factura con un Ollama. Si no se define FINANZAS_OLLAMA_URL, el clasificador usa
# solo historial + diccionario y no sale a la red.
# FINANZAS_OLLAMA_URL=http://localhost:11434
# FINANZAS_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
